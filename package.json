{
  "name": "chek-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build && bun scripts/cloudflare.ts",
    "check": "bun --bun astro check",
    "deploy": "bun run build && cf deploy --prebuilt",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.5",
    "@astrojs/starlight": "0.42.7",
    "astro": "7.4.2",
    "sharp": "0.35.5",
    "starlight-openapi": "0.27.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cloudflare/build-output-utils": "0.9.3",
    "@types/bun": "^1.4.4",
    "cf": "^1.0.0-beta.13",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.86.0",
    "typescript": "^6"
  },
  "packageManager": "bun@1.4.3"
}
